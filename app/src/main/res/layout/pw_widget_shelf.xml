<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pw_widget_binding"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pw_widget_paper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_notice"
                style="@style/Widget.Pageworn.Notice"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="7dp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:maxLines="3"
                android:paddingHorizontal="12dp"
                android:paddingTop="1dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/widget_books"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingTop="6dp" />
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@drawable/pw_widget_page_edges"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_keys"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp" />
</LinearLayout>
