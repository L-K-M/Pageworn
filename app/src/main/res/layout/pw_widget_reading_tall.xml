<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pw_widget_binding"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingBottom="5dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pw_widget_paper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_cover"
                    android:layout_width="112dp"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pw_cover_cloth" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        style="@style/Widget.Pageworn.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textSize="20sp"
                        android:text="The Night Orchard"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/widget_author"
                        style="@style/Widget.Pageworn.Segment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Elin Ward"
                        android:textColor="@color/widget_secondary"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_segment_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/widget_segment"
                    style="@style/Widget.Pageworn.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:text="The Gate"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/widget_segment_left"
                    style="@style/Widget.Pageworn.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="13 min left"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/widget_segment_bar"
                    style="@style/Widget.Pageworn.Bar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="1000"
                    android:progress="400" />

                <TextView
                    android:id="@+id/widget_book_line"
                    style="@style/Widget.Pageworn.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Book · 2 h 08 min of 4 h 20 min"
                    tools:ignore="HardcodedText" />

                <ProgressBar
                    android:id="@+id/widget_book_bar"
                    style="@style/Widget.Pageworn.Bar"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:max="1000"
                    android:progress="490" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_notice"
                style="@style/Widget.Pageworn.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/widget_key_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_back"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/pw_key_ivory_skip"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/pw_inlay_back_15" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/widget_toggle"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="@drawable/pw_key_oxblood"
                    android:contentDescription="@string/widget_now_reading"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="19dp"
                    android:src="@drawable/pw_inlay_play" />

                <FrameLayout
                    android:id="@+id/widget_forward"
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/pw_key_ivory_skip"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/pw_inlay_forward_30" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@drawable/pw_widget_page_edges"
        android:importantForAccessibility="no" />
</LinearLayout>
