<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The one designed theme, also when the phone is in dark mode (docs/02-interface.md).
         The colours are light, but isLightTheme says otherwise on purpose: Android inverts a
         window whose theme claims to be light when "Make more apps dark" is on, and it ignores
         forceDarkAllowed for that. forceDarkAllowed still covers the older automatic darkening. -->
    <style name="Theme.Pageworn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:isLightTheme">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
